#!/bin/bash
# Copilot JSONL mock dispatcher. Resolves the scenario like the claude mock
# (MOCK_AGENT_SCENARIO → MOCK_CLAUDE_SCENARIO → stream-done) but selects the
# captured Copilot CLI event shape consumed by CopilotJsonlParser.
SCENARIO="${MOCK_AGENT_SCENARIO:-${MOCK_CLAUDE_SCENARIO:-stream-done}}"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
export MOCK_AGENT_FORMAT=copilot-jsonl
exec bash "$SCRIPT_DIR/scenarios/${SCENARIO}.sh" "$@"
