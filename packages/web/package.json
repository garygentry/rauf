{
  "name": "@ralph/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/dev.ts",
    "dev:vite": "vite",
    "dev:server": "bun run src/server/index.ts",
    "build": "vite build && bun run ../../scripts/generate-embedded-assets.ts && prettier --write src/server/embedded-assets.ts && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist build"
  },
  "dependencies": {
    "@ralph/core": "workspace:*",
    "@ralph/loop": "workspace:*",
    "@tanstack/react-query": "^5.65.0",
    "zod": "^3.24.0",
    "@tanstack/react-router": "^1.100.0",
    "hono": "^4.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "bun-types": "^1.2.0",
    "eslint": "^9.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  }
}
