{
  "name": "@rauf/core",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./state-labels": {
      "import": "./dist/state-labels.js",
      "types": "./dist/state-labels.d.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "bun run ../../scripts/generate-json-schemas.ts && bun run ../../scripts/generate-embedded-artifacts.ts && prettier --write src/embedded-artifacts.ts && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bun-types": "^1.2.0",
    "vitest": "^3.0.0",
    "typescript": "^5.7.0",
    "eslint": "^9.0.0",
    "zod-to-json-schema": "^3.25.1"
  }
}
